+// [CHOSEN, not recovered] TEXCOORD reloads/clamps an SM1.1-1.3 input;
+// TEXCRD in SM1.4 copies its explicit source without the legacy clamp.
+void emit_METAL_TEXCRD(Context *ctx)
+{
+    char code[256];
+    if (shader_version_atleast(ctx, 1, 4))
+    {
+        char src[128];
+        make_METAL_srcarg_string(ctx, 0, ctx->dest_arg.writemask, src, sizeof (src));
+        make_METAL_destarg_assign(ctx, code, sizeof (code), "%s", src);
+    }
+    else
+    {
+        char dst[64], swizzle[6];
+        get_METAL_destarg_varname(ctx, dst, sizeof (dst));
+        ctx->metal_need_header_common = 1;
+        make_METAL_swizzle_string(swizzle, sizeof (swizzle), 0xE4, ctx->dest_arg.writemask);
+        make_METAL_destarg_assign(ctx, code, sizeof (code),
+                                 "clamp(input.%s%s, 0.0, 1.0)", dst, swizzle);
+    }
+    output_line(ctx, "%s", code);
+}
 
