--- a/profiles/mojoshader_profile_metal.c	2026-10-31 23:08:22
+++ b/profiles/mojoshader_profile_metal.c	2026-10-31 23:16:01
@@ -2156,8 +2156,26 @@
 
 void emit_METAL_EXPP(Context *ctx)
 {
-    // !!! FIXME: msdn's asm docs don't list this opcode, I'll have to check the driver documentation.
-    emit_METAL_EXP(ctx);  // I guess this is just partial precision EXP?
+    // vs_1_x expp (Direct3D 9): x = 2^floor(s), y = s - floor(s), z = 2^s, w = 1.
+    //  d3dx9 uses its .y for frac() in vs_1_1. From vs_2_0 on it is a scalar exp2.
+    if (shader_is_vertex(ctx) && !shader_version_atleast(ctx, 2, 0))
+    {
+        const int mask = ctx->dest_arg.writemask;
+        char src0[64]; make_METAL_srcarg_string_scalar(ctx, 0, src0, sizeof (src0));
+        char swiz[8] = { '\0' }; int n = 0;
+        char code[256];
+        if (writemask_x(mask) || (mask & 1)) swiz[n++] = 'x';
+        if (mask & 2) swiz[n++] = 'y';
+        if (mask & 4) swiz[n++] = 'z';
+        if (mask & 8) swiz[n++] = 'w';
+        swiz[n] = '\0';
+        ctx->metal_need_header_math = 1;
+        make_METAL_destarg_assign(ctx, code, sizeof (code),
+            "float4(exp2(floor(%s)), %s - floor(%s), exp2(%s), 1.0).%s", src0, src0, src0, src0, swiz);
+        output_line(ctx, "%s", code);
+        return;
+    } // if
+    emit_METAL_EXP(ctx);  // Partial precision EXP.
 } // emit_METAL_EXPP
 
