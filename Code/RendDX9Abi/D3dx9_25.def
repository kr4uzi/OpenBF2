; [CHOSEN, not recovered] Import-library definition for d3dx9_25.dll, used only when the build has
; no April 2005 DirectX SDK (Code/Build/dxsdk.cmd, BF2_D3DX). renddx9.cmd and textureatlasbuilder.cmd
; turn it into d3dx9_25.lib with `lib /def /machine:x86|x64`. The SDK's own d3dx9.lib is preferred.
;
; Names only, no ordinals: the x86 and x64 d3dx9_25.dll export the same 323 names, but four of them
; (D3DXMatrixAffineTransformation[2D], D3DXMatrixTransformation[2D]) have other ordinals on x64, so
; the image imports by name as the SDK library does. Every entry here is a d3dx9_25.dll export in both
; architectures; tools/d3dx/check_d3dx9_25.py checks that.
;
; The list is what the rebuilt RendDX9.dll and TextureAtlasBuilder.dll call. An unused entry costs
; nothing: the linker binds only referenced imports. On x86, D3dx9Fallback.h maps each decorated
; __stdcall reference (_Name@bytes) onto the plain name this library defines.

LIBRARY d3dx9_25.dll

EXPORTS
    D3DXAssembleShader
    D3DXComputeBoundingBox
    D3DXComputeBoundingSphere
    D3DXComputeNormals
    D3DXConvertMeshSubsetToSingleStrip
    D3DXCreateBox
    D3DXCreateBuffer
    D3DXCreateCylinder
    D3DXCreateEffect
    D3DXCreateEffectCompiler
    D3DXCreateEffectPool
    D3DXCreateLine
    D3DXCreateMesh
    D3DXCreateMeshFVF
    D3DXCreatePolygon
    D3DXCreateRenderToSurface
    D3DXCreateSphere
    D3DXCreateTexture
    D3DXCreateTextureFromFileExA
    D3DXCreateTextureFromFileInMemory
    D3DXCreateTorus
    D3DXDisassembleEffect
    D3DXFillTexture
    D3DXFilterTexture
    D3DXFloat32To16Array
    D3DXGetImageInfoFromFileA
    D3DXGetImageInfoFromFileInMemory
    D3DXGetShaderConstantTable
    D3DXGetShaderVersion
    D3DXLoadSurfaceFromMemory
    D3DXLoadSurfaceFromSurface
    D3DXMatrixInverse
    D3DXMatrixLookAtLH
    D3DXMatrixMultiply
    D3DXMatrixOrthoLH
    D3DXMatrixRotationZ
    D3DXMatrixScaling
    D3DXMatrixTranslation
    D3DXMatrixTranspose
    D3DXSaveSurfaceToFileA
    D3DXSaveTextureToFileA
